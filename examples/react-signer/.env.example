# Copy this file to `.env` and fill in your Turnkey organization.
# Find your organization ID at https://app.turnkey.com/dashboard.
VITE_TURNKEY_ORGANIZATION_ID=your-turnkey-org-id-here

# Optional: Relying-Party ID used for WebAuthn/passkey challenges.
# Defaults to window.location.hostname if unset. Set this only if your app is
# served from a different domain than the one registered in Turnkey.
# VITE_TURNKEY_RP_ID=localhost
